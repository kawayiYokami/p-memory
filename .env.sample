# 真实嵌入 / 重排模型配置。
#
# 复制成 .env（.env 已在 .gitignore 中，不会进仓库）后填入真实值：
#   cp .env.sample .env
#
# examples/real_models.py 读取它，对真实模型跑一遍库内端到端链路。

# OpenAI 兼容接口前缀，通常以 /v1 结尾。
P_MEMORY_BASE_URL=https://api.siliconflow.cn/v1
P_MEMORY_API_KEY=

# 嵌入模型与它的向量维度。维度必须与模型真实输出一致，否则注册会被拒绝绑定。
P_MEMORY_EMBEDDING_MODEL=BAAI/bge-m3
P_MEMORY_EMBEDDING_DIMENSION=1024
# 声明给库的单批条数上限；模型真实上限更小时，库会在命中「批次过大」后自动减半。
P_MEMORY_EMBEDDING_BATCH=50

# 重排模型。留空则跳过重排注册，只测嵌入加全文。
P_MEMORY_RERANK_MODEL=BAAI/bge-reranker-v2-m3
